@article{ WOS:001174867800001,
Author = {Rigter, Pomme M. F. and de Konink, Charlotte and Dunn, Matthew J. and
   Onori, Martina Proietti and Humberson, Jennifer B. and Thomas, Matthew
   and Barnes, Caitlin and Prada, Carlos E. and Weaver, K. Nicole and Ryan,
   Thomas D. and Caluseriu, Oana and Conway, Jennifer and Calamaro, Emily
   and Fong, Chin-To and Wuyts, Wim and Meuwissen, Marije and Hordijk, Eva
   and Jonkers, Carsten N. and Anderson, Lucas and Yuseinova, Berfin and
   Polonia, Sarah and Beysen, Diane and Stark, Zornitza and Savva, Elena
   and Poulton, Cathryn and McKenzie, Fiona and Bhoj, Elizabeth and Bupp,
   Caleb P. and Bezieau, Stephane and Mercier, Sandra and Blevins, Amy and
   Wentzensen, Ingrid M. and Xia, Fan and Rosenfeld, Jill A. and Hsieh,
   Tzung-Chien and Krawitz, Peter M. and Elbracht, Miriam and Veenma,
   Danielle C. M. and Schulman, Howard and Stratton, Margaret M. and Kury,
   Sebastien and van Woerden, Geeske M.},
Title = {Role of CAMK2D in neurodevelopment and associated conditions},
Journal = {AMERICAN JOURNAL OF HUMAN GENETICS},
Year = {2024},
Volume = {111},
Number = {2},
Month = {FEB 1},
Abstract = {The calcium/calmodulin-dependent protein kinase type 2 (CAMK2) family
   consists of four different isozymes, encoded by four different
   genes-CAMK2A, CAMK2B, CAMK2G, and CAMK2D-of which the first three have
   been associated recently with neurodevelopmental disorders. CAMK2D is
   one of the major CAMK2 proteins expressed in the heart and has been
   associated with cardiac anomalies. Although this CAMK2 isoform is also
   known to be one of the major CAMK2 subtypes expressed during early brain
   development, it has never been linked with neurodevelopmental disorders
   until now. Here we show that CAMK2D plays an important role in
   neurodevelopment not only in mice but also in humans. We identified
   eight individuals harboring heterozygous variants in CAMK2D who display
   symptoms of intellectual disability, delayed speech, behavioral
   problems, and dilated cardiomyopathy. The majority of the variants
   tested lead to a gain of function (GoF), which appears to cause both
   neurological problems and dilated cardiomyopathy. In contrast, loss -of
   -function (LoF) variants appear to induce only neurological symptoms.
   Together, we describe a cohort of individuals with neurodevelopmental
   disorders and cardiac anomalies, harboring pathogenic variants in
   CAMK2D, confirming an important role for the CAMK2D isozyme in both
   heart and brain function.},
